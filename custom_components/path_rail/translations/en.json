{
  "title": "PATH Rail",
  "config": {
    "step": {
      "user": {
        "title": "Set up PATH Rail",
        "description": "Select stations from the public RidePATH feed. No account or API key is required.",
        "data": {
          "stations": "Stations",
          "stale_after": "Maximum source age (seconds)"
        },
        "data_description": {
          "stations": "Choose stations to monitor. All use a single shared request every 30 seconds.",
          "stale_after": "Maximum age of each prediction's source timestamp. This does not change the fixed 30-second polling interval (120–1800 seconds)."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot retrieve the PATH feed. Check internet access and try again.",
      "invalid_feed": "The server returned an empty or unsupported feed. Try again later.",
      "select_station": "Select at least one station.",
      "station_missing": "None of the selected stations is present in the current feed."
    },
    "abort": {
      "already_configured": "PATH Rail is already configured. Use Configure to change stations."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "PATH Rail options",
        "description": "Changes reload the integration. Entities for removed stations become unavailable; you may remove their registry entries manually.",
