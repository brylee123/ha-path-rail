          "stations": "Stations",
          "stale_after": "Maximum source age (seconds)"
        },
        "data_description": {
          "stations": "Choose stations to monitor. All use a single shared request every 30 seconds.",
          "stale_after": "Maximum age of each prediction's source timestamp. This does not change the fixed 30-second polling interval (120–1800 seconds)."
        }
      }
    },
    "error": {
      "select_station": "Select at least one station."
    }
